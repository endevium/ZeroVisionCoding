{
  "name": "zero-vision-coding",
  "displayName": "Zero Vision Coding",
  "description": "Zero Vision Coding helps visually impaired developers code independently using voice guidance, accessible navigation, and AI-assisted code understanding.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:zero-vision-coding.helloWorld",
    "onCommand:zero-vision-coding.runProgram"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "zero-vision-coding.helloWorld",
        "title": "Zero Vision Coding: Hello World"
      },
      {
        "command": "zero-vision-coding.runProgram",
        "title": "Zero Vision Coding: Run Program"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.108.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.2"
  },
  "dependencies": {
    "punycode": "^2.3.1"
  }
}
