</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger);
  gsap.registerPlugin(SplitText);

  document.addEventListener("DOMContentLoaded", () => {
    const features = gsap.utils.toArray<HTMLElement>(".feature");

    const titleSplit = new SplitText("#features-title", {
      type: "words,chars",
      charsClass: "char",
    });

    const descriptionSplit = new SplitText("#features-description", {
      type: "words",
    });

    const t1 = gsap.timeline({
      scrollTrigger: {
        trigger: "#features-title",
        start: "top 30%",
        end: "end 20%",
        toggleActions: "play none none reverse",
      },
    });

    t1.from(titleSplit.chars, {
      y: 150,
      opacity: 0,
      duration: 0.5,
      ease: "power4.out",
      stagger: 0.04,
    })
      .from(
        descriptionSplit.words,
        {
          y: 20,
          opacity: 0,
          duration: 0.5,
          ease: "power3.out",
          stagger: 0.03,
        },
        "-=0.4",
      )
      .from(
        features,
        {
          y: 20,
          opacity: 0,
          duration: 0.5,
          ease: "power3.out",
          stagger: 0.03,
        },
        "-=0.5",
      );

    features.forEach((feature, index) => {
      const inner = feature.querySelector(".feature-inner");

      if (inner) {
        gsap.from(inner, {
          scrollTrigger: {
            trigger: feature,
            start: "top 70%",
            toggleActions: "play none none reverse",
          },
          xPercent: index % 2 === 0 ? -20 : 20,
          opacity: 0,
          duration: 1,
          ease: "power3.out",
        });
      }
    });
  });
</script>
