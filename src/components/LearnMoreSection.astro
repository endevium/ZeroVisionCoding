              >
                <span
                  class="flex items-center justify-center w-8 h-8 rounded-full bg-gradient-to-r from-purple-500 to-pink-500 [body[data-theme='night']_&]:from-[#C824EC] [body[data-theme='night']_&]:to-[#DF308D] text-white text-sm font-bold shadow-md shadow-purple-500/20 [body[data-theme='night']_&]:shadow-[0_0_10px_rgba(200,36,236,0.5)]"
