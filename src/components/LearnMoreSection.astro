          </div>
        </div>
      </div>
    </div>

    <!-- Third Feature -->
    <div class="feature h-auto lg:h-[60vh] w-full flex items-center overflow-hidden">
      <div
        class="feature-inner flex flex-col lg:flex-row gap-10 lg:gap-15 w-full items-center justify-center"
      >
        <div class="flex flex-col gap-4 justify-center w-full lg:w-1/2">
          <h2
