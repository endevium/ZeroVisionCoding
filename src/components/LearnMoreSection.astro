            class="bg-gradient-to-r from-purple-600 to-pink-500 [body[data-theme='night']_&]:from-[#C824EC] [body[data-theme='night']_&]:to-[#DF308D] bg-clip-text text-transparent font-orbitron text-2xl lg:text-[35px] font-bold drop-shadow-sm [body[data-theme='night']_&]:drop-shadow-[0_0_10px_rgba(200,36,236,0.2)] text-center lg:text-left"
          >
            VS Code Integration
          </h2>
          <p
            class="text-gray-700 [body[data-theme='night']_&]:text-gray-300 font-inter font-light text-lg lg:text-[21px] leading-relaxed text-center lg:text-left"
