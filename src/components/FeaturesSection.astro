---
import DriftWall from "./DriftWall.jsx";

const items = [
  {
    image: "https://picsum.photos/id/1015/600/400",
    title: "Peaks",
    href: "https://example.com/one",
  },
  {
    image: "https://picsum.photos/id/1025/600/400",
    title: "Pup",
    href: "https://example.com/two",
  },
  {
    image: "https://picsum.photos/id/1039/600/400",
    title: "Falls",
    href: "https://example.com/three",
  },
];
---

<div
  id="stories-section" class="flex flex-col w-full pt-32 lg:pt-20 px-6 lg:px-20 min-h-screen lg:h-[110vh] justify-center items-center gap-7 overflow-hidden"
>
  <div id="stories-content" class="flex flex-col gap-4 relative z-10">
    <h2 id="stories-title" class="text-gray-900 [body[data-theme='night']_&]:text-white font-orbitron text-3xl lg:text-[40px] font-black tracking-wide drop-shadow-md [body[data-theme='night']_&]:drop-shadow-[0_0_15px_rgba(255,255,255,0.2)] text-center">
      <span class="text-lavender [body[data-theme='night']_&]:text-purple drop-shadow-[0_0_10px_rgba(200,36,236,0.3)]">Their stories. </span> Our inspiration.
    </h2>
    <p id="stories-description" class="text-gray-700 [body[data-theme='night']_&]:text-gray-300 font-inter font-light text-lg lg:text-[21px] text-center px-4 lg:px-0">
      Every feature of Zero Vision Coding begins with <br />
      understanding the people we hope to empower.
    </p>
  </div>

  <div id="drift-wall" class="flex flex-row justify-center items-center w-full h-[60vh] lg:h-full p-2 lg:p-7 drop-shadow-[0_10px_30px_rgba(200,36,236,0.15)] [body[data-theme='night']_&]:drop-shadow-[0_0_40px_rgba(200,36,236,0.3)]">
    <DriftWall
      client:load
      items={items}
      columns={5}
      tileWidth={300}
      tileHeight={332}
      gap={18}
      tilt={0}
      turn={0}
      perspective={2350}
      depth={120}
      speed={45}
      direction="up"
      variance={0.45}
      parallax={0.6}
      lift={64}
      fade={0.1}
      dim={0.95}
      overlayColor="#060010"
      radius={14}
      roll={0}
      pauseOnHover={false}
      grayscale={false}
    />
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger)
  gsap.registerPlugin(SplitText);

  document.addEventListener("DOMContentLoaded", () => {

    const titleSplit = new SplitText("#stories-title", {
      type: "words,chars",
      charsClass: "char"
    });

    const descriptionSplit = new SplitText("#stories-description", {
      type: "words"
    });



    const tl = gsap.timeline({
        scrollTrigger: {
            trigger: "#stories-section",
            start: "top 90%",
            end: "end 20%",
            toggleActions: "play none none reverse"
        }
    });

    tl.from(titleSplit.chars, {
        y: 150,
        opacity: 0,
        duration: 0.5,
        ease: "power4.out",
        stagger: 0.04
    })
    // Description
    .from(descriptionSplit.words, {
        y: 20,
        opacity: 0,
        duration: 0.5,
        ease: "power3.out",
        stagger: 0.03
    }, "-=0.4")
    .from("#drift-wall", {
        y: 80,
        opacity: 0,
        scale: 0.95,
        duration: 1,
        ease: "power3.out"
    }, "-=0.1");
  })
</script>