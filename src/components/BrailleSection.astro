---
import { Image } from "astro:assets";
import { Demo } from "./ui/video-player.tsx";
---

<div
  id="braille-section"
  class="flex flex-col lg:flex-row min-h-screen lg:h-[100vh] pt-32 lg:pt-40 px-6 lg:px-20 justify-center items-center gap-12 lg:gap-0 relative z-10 overflow-hidden"
>
  <div class="flex w-full aspect-video lg:aspect-auto lg:h-[75vh] lg:w-2/3 justify-center items-center">
    <div
      id="braille-video"
      class="w-full h-full bg-black rounded-2xl border border-gray-200/50 [body[data-theme='night']_&]:border-purple-500/30 drop-shadow-2xl [body[data-theme='night']_&]:drop-shadow-[0_0_30px_rgba(200,36,236,0.3)] overflow-hidden"
    >
      <video controls class="w-full h-full object-cover rounded-2xl">
        <source
          src="https://stream.mux.com/VZtzUzGRv02OhRnZCxcNg49OilvolTqdnFLEqBsTwaxU/high.mp4"
          type="video/mp4"
        />
      </video>
    </div>
  </div>

  <div
    class="flex flex-col gap-4 items-center lg:items-start justify-center lg:pl-10 w-full lg:w-1/3"
  >
    <h2
      id="braille-title"
      class="text-gray-900 [body[data-theme='night']_&]:text-white font-orbitron text-3xl lg:text-[40px] font-bold text-center lg:text-left drop-shadow-md [body[data-theme='night']_&]:drop-shadow-[0_0_15px_rgba(255,255,255,0.2)]"
    >
      Code through <span
        class="text-lavender [body[data-theme='night']_&]:text-purple drop-shadow-[0_0_10px_rgba(200,36,236,0.3)]"
      >
        touch</span>
    </h2>
    <p
      id="braille-description"
      class="text-gray-700 [body[data-theme='night']_&]:text-gray-300 font-inter font-light text-lg lg:text-[21px] text-center lg:text-left"
    >
      Experience programming through a tactile<br class="hidden lg:block" />
      Braille keyboard built for accessibility.
    </p>

    <a
      href="/#contact"
      id="braille-btn"
      class="flex w-full sm:w-45 bg-lavender [body[data-theme='night']_&]:bg-purple hover:scale-105 hover:shadow-xl hover:shadow-purple-500/20 [body[data-theme='night']_&]:hover:shadow-[0_0_25px_rgba(200,36,236,0.6)] text-white font-inter font-bold text-[16px] h-14 my-5 items-center justify-center rounded-xl cursor-pointer border border-transparent hover:border-white/50"
    >
      Order Now
    </a>
  </div>
</div>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";

  gsap.registerPlugin(ScrollTrigger);
  gsap.registerPlugin(SplitText);

  document.addEventListener("DOMContentLoaded", () => {
    const titleSplit = new SplitText("#braille-title", {
      type: "words,chars",
      charsClass: "char",
    });

    const descriptionSplit = new SplitText("#braille-description", {
      type: "words",
    });

    const t1 = gsap.timeline({
      scrollTrigger: {
        trigger: "#braille-title",
        start: "top 100%",
        end: "end 20%",
        toggleActions: "play none none reverse",
      },
    });

    t1.from(titleSplit.chars, {
      y: 150,
      opacity: 0,
      duration: 0.5,
      ease: "power4.out",
      stagger: 0.04,
    })
      .from(
        descriptionSplit.words,
        {
          y: 20,
          opacity: 0,
          duration: 0.5,
          ease: "power3.out",
          stagger: 0.03,
        },
        "-=0.4",
      )
      .from(
        "#braille-btn",
        {
          y: 50,
          opacity: 0,
          duration: 0.8,
          ease: "power3.out",
        },
        "-=0.3",
      )
      .from(
        "#braille-video",
        {
          x: -1000,
          opacity: 0,
          duration: 0.5,
        },
        "-=0.3",
      );
  });
</script>
