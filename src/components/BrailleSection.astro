---
import { Image } from "astro:assets";
import { Demo } from "./ui/video-player.tsx";
---

<div id="braille-section" class="flex flex-col rounded border lg:flex-row h-[100vh] lg:pt-40 px-6 lg:px-20 justify-center items-center gap-12 lg:gap-0">
    <div class="flex w-full h-[75vh] lg:w-2/3 justify-center items-center">
        <div id="braille-video" class="w-full h-full bg-black rounded-2xl border border-white">
            <video controls class="w-full h-full object-cover rounded">
                <source src="https://stream.mux.com/VZtzUzGRv02OhRnZCxcNg49OilvolTqdnFLEqBsTwaxU/high.mp4" type="video/mp4">
            </video>
        </div>
    </div>

    <div class="flex flex-col gap-4 items-center lg:items-start justify-center lg:pl-10 w-full lg:w-1/3">
        <h2 id="braille-title" class="text-black [body[data-theme='night']_&]:text-white font-orbitron text-[35px] font-bold text-center lg:text-left">Code through <span class="text-lavender [body[data-theme='night']_&]:bg-gradient-to-r [body[data-theme='night']_&]:from-[#C824EC] [body[data-theme='night']_&]:to-[#DF308D] [body[data-theme='night']_&]:bg-clip-text [body[data-theme='night']_&]:text-transparent"> touch</span></h2>
        <p id="braille-description" class="text-black [body[data-theme='night']_&]:text-white font-inter [body[data-theme='night']_&]:font-thin text-[19px] text-center lg:text-left">
            Experience programming through a tactile<br class="hidden lg:block" />
            Braille keyboard built for accessibility.
        </p>

        <button id="braille-btn" class="flex bg-lavender text-white font-inter font-bold text-[16px] h-14 w-45 my-5 items-center justify-center rounded hover:opacity-90 cursor-pointer">
            Order Now
        </button>
    </div>
</div>

<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger);
    gsap.registerPlugin(SplitText);

    document.addEventListener("DOMContentLoaded", () => {
        const titleSplit = new SplitText("#braille-title", {
            type: "words,chars",
            charsClass: "char"
        });

        const descriptionSplit = new SplitText("#braille-description", {
            type: "words"
        })


        const t1 = gsap.timeline({
            scrollTrigger: {
                trigger: "#braille-title",
                start: "top 100%",
                end: "end 20%",
                toggleActions: "play none none reverse"
            }
        })

        t1.from(titleSplit.chars, {
            y: 150,
            opacity: 0,
            duration: 0.5,
            ease: "power4.out",
            stagger: 0.04
        })
        .from(descriptionSplit.words, {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power3.out",
            stagger: 0.03
        }, "-=0.4")
        .from("#braille-btn", {
            y: 50,
            opacity: 0,
            duration: 0.8,
            ease: "power3.out"
        }, "-=0.3")
        .from("#braille-video", {
            x: -1000,
            opacity: 0,
            duration: 0.5
        }, "-=0.3")
    });
</script>