<div class="flex flex-col h-[120vh] pr-20 pl-20 justify-center items-center gap-10">
    <div class="flex flex-col gap-4 justify-center z-10">
        <h2 class="font-orbitron text-[30px] font-bold text-center text-lavender">Contact Us</h2>
        <p class="text-black [body[data-theme='night']_&]:text-white font-inter [body[data-theme='night']_&]:font-thin text-[19px]">
            Have questions, feedback, or want to order our Braille keyboard? Send us a message and we’ll be happy to assist you.
        </p>
    </div>

    <div class="flex flex-row justify-center items-center" id="contact">
        <div id="contact-box" class="flex flex-row gap-3 bg-white [body[data-theme='night']_&]:bg-[#0a0a0f] p-13 justify-between rounded border [body[data-theme='night']_&]:border-darkgray">
            <div class="flex flex-col relative gap-4 w-150 justify-end border rounded p-5">
                <div class="absolute inset-0 w-full h-full bg-[url('/blind-individuals.jpg')] bg-no-repeat bg-cover bg-center">
                </div>

                <h2 class="text-white [body[data-theme='night']_&]:text-white font-orbitron text-[23px] text-left">Email:</h2>
                <p class="text-white [body[data-theme='night']_&]:text-white font-inter [body[data-theme='night']_&]:font-thin text-[20px] tracking-wider">
                    zerovisioncoding@gmail.com
                </p>

                <h2 class="text-white [body[data-theme='night']_&]:text-white font-orbitron text-[23px] text-left">Phone:</h2>
                <p class="text-white [body[data-theme='night']_&]:text-white font-inter [body[data-theme='night']_&]:font-thin text-[20px] tracking-wider">
                    +63 912 3456 789
                </p>
            </div>

            <div class="flex justify-center items-center w-140 h-155 rounded p-5 bg-white [body[data-theme='night']_&]:bg-[#0a0a0f] [body[data-theme='night']_&]:border-darkgray border">
                <form class="flex flex-col gap-4" aria-required>
                    <div class="flex flex-row gap-4">
                        <div class="flex flex-col gap-2">
                            <label class="text-black [body[data-theme='night']_&]:text-white [body[data-theme='night']_&]:font-thin text-[17px]">First Name</label>
                            <input class="border [body[data-theme='night']_&]:border-darkgray h-12 w-61 rounded text-white p-4" type="text" />
                        </div>

                        <div class="flex flex-col gap-2">
                            <label class="text-black [body[data-theme='night']_&]:text-white [body[data-theme='night']_&]:font-thin text-[17px]">Last Name</label>
                            <input class="border [body[data-theme='night']_&]:border-darkgray h-12 w-61 rounded text-white p-4" type="text" />
                        </div>
                    </div>

                    <div>
                        <div class="flex flex-col gap-2">
                            <label class="text-black [body[data-theme='night']_&]:text-white [body[data-theme='night']_&]:font-thin text-[17px]">Email Address</label>
                            <input class="border [body[data-theme='night']_&]:border-darkgray h-12 w-126 rounded text-purple [body[data-theme='night']_&]:text-white p-4" type="email" />
                        </div>
                    </div>

                    <div>
                        <div class="flex flex-col gap-4">
                            <label class="text-black [body[data-theme='night']_&]:text-white [body[data-theme='night']_&]:font-thin text-[17px]">Message</label>
                            <textarea class="border [body[data-theme='night']_&]:border-darkgray h-52 w-126 rounded text-white p-4 resize-none" />
                        </div>
                    </div>

                    <div>
                        <input type="submit" class="flex bg-lavender text-white font-inter font-bold text-[15px] h-14 w-126 my-5 items-center justify-center rounded" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger);
    gsap.registerPlugin(SplitText);

    document.addEventListener("DOMContentLoaded", () => {
        const t1 = gsap.timeline({
            scrollTrigger: {
                trigger: "#contact-box",
                start: "top 30%",
                end: "end 50%",
                toggleActions: "play none none reverse"
            }
        })

        t1.from("#contact-box", {
            x: -100,
            opacity: 0,
            duration: 0.9,
            ease: "bounce.out"
        })
    });
</script>