---
// HeroGradient.astro
---


<style>
  .hero-gradient {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: var(--sp-12) var(--sp-6);
  }
  .hero-gradient__bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg,
      rgba(255, 138, 247, 0.07) 0%,
      transparent 30%,
      transparent 30%,
      rgba(255, 138, 247, 0.07) 100%);
    animation: gradientShift 10s ease-in-out infinite alternate;
  }
  @keyframes gradientShift {
    0% { opacity: 0.6; transform: scale(1); }
    100% { opacity: 1; transform: scale(1.1); }
  }
</style>