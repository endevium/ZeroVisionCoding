---
import { Image } from "astro:assets";
import { Demo } from "./ui/video-player.tsx";
---

<div class="flex flex-col-reverse lg:flex-row min-h-[100vh] pt-32 lg:pt-40 px-6 lg:px-20 justify-center items-center gap-12 lg:gap-0">
    <div class="flex w-full h-[75vh] lg:w-2/3 justify-center items-center">
        <div class="w-full h-full bg-black rounded-2xl border border-white">
            <video controls class="w-full h-full object-cover rounded-2xl">
                <source src="https://stream.mux.com/VZtzUzGRv02OhRnZCxcNg49OilvolTqdnFLEqBsTwaxU/high.mp4" type="video/mp4">
            </video>
        </div>
    </div>

    <div class="flex flex-col gap-4 items-center lg:items-start justify-center lg:pl-10 w-full lg:w-1/3">
        <h2 class="text-white font-orbitron text-[35px] font-bold text-center lg:text-left">Code through <span class="bg-gradient-to-r from-[#C824EC] to-[#DF308D] bg-clip-text text-transparent"> touch</span></h2>
        <p class="text-white font-inter font-thin text-[19px] text-center lg:text-left">
            Experience programming through a tactile<br class="hidden lg:block" />
            Braille keyboard built for accessibility.
        </p>

        <button class="flex bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white font-inter font-bold text-[16px] h-14 w-45 my-5 items-center justify-center rounded-lg hover:opacity-90 transition-opacity cursor-pointer">
            Order Now
        </button>
    </div>
</div>