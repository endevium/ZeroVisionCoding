---
import { FirstFeature } from "./ui/video-player.tsx";
---


<div class="flex flex-col w-full px-6 lg:px-20 pt-32 pb-20">
    <div class="flex flex-col gap-4 justify-center items-center min-h-[40vh]">
        <h2 id="features-title" class="text-white font-orbitron text-[36px] font-bold text-center">
            Built for <span class="bg-gradient-to-r from-[#C824EC] to-[#DF308D] bg-clip-text text-transparent"> Accessible Programming
            </span>
        </h2>
        <p id="features-description" class="text-white font-inter font-thin text-[19px] text-center">
            Explore the tools that make programming more accessible, <br />
            from tactile Braille input and voice commands to <br />
            AI-assisted code feedback.
        </p>
    </div>

    <div id="features" class="relative flex flex-col w-full">
        <!-- First Feature -->
        <div class="feature h-screen w-full bg-[#05030a] flex items-center overflow-hidden">
            <div class="feature-inner flex flex-col lg:flex-row gap-10 lg:gap-15 w-full items-center justify-center">
                <div class="flex flex-col gap-4 justify-center w-full lg:w-1/2">
                    <h2 class="text-white font-orbitron text-[30px] font-medium">Voice Commands</h2>
                    <p class="text-white font-inter font-thin text-[19px]">
                        Navigate and interact with the coding environment through speech.
                    </p>

                    <div class="h-auto lg:h-[15vh] flex items-center mt-4">
                        <ul class="flex flex-col gap-2 text-white">
                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Voice-based navigation
                            </li>

                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Less reliance on visual interfaces
                            </li>

                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Accessible and comprehensible commands system
                            </li>
                        </ul>
                    </div>
                </div>
                <div class="w-full lg:w-[85vh] h-[40vh] lg:h-[60vh] bg-gradient-to-r from-[#C824EC] to-[#DF308D] p-[3px] rounded-lg">
                    <div class="w-full h-full bg-black rounded-2xl">
                        <video controls class="w-full h-full object-cover rounded-lg">
                            <source src="https://stream.mux.com/VZtzUzGRv02OhRnZCxcNg49OilvolTqdnFLEqBsTwaxU/high.mp4" type="video/mp4">
                        </video>
                    </div>
                </div>
            </div>
        </div>

        <!-- Second Feature -->
         <div class="feature h-screen w-full bg-[#05030a] flex items-center overflow-hidden">
            <div class="feature-inner flex flex-col-reverse lg:flex-row gap-10 lg:gap-15 w-full items-center justify-center">
                <div class="w-full lg:w-[85vh] h-[40vh] lg:h-[60vh] bg-gradient-to-r from-[#C824EC] to-[#DF308D] p-[3px] rounded-lg">
                    <div class="w-full h-full bg-black rounded-2xl">
                        <video controls class="w-full h-full object-cover rounded-lg">
                            <source src="https://stream.mux.com/VZtzUzGRv02OhRnZCxcNg49OilvolTqdnFLEqBsTwaxU/high.mp4" type="video/mp4">
                        </video>
                    </div>
                </div>

                <div class="flex flex-col gap-4 justify-center w-full lg:w-1/2">
                    <h2 class="text-white font-orbitron text-[30px] font-medium">Audio Feedback</h2>
                    <p class="text-white font-inter font-thin text-[19px]">
                        Receive spoken feedback from the coding environment to understand code, actions, and system responses without relying on visual output.
                    </p>

                    <div class="h-auto lg:h-[15vh] flex items-center mt-4">
                        <ul class="flex flex-col gap-2 text-white">
                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Text-to-speech feedback
                            </li>

                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Audio-based interaction
                            </li>

                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Quick system responses
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        <!-- Third Feature -->
        <div class="feature h-screen w-full bg-[#05030a] flex items-center overflow-hidden">
            <div class="feature-inner flex flex-col lg:flex-row gap-10 lg:gap-15 w-full items-center justify-center">
                <div class="flex flex-col gap-4 justify-center w-full lg:w-1/2">
                    <h2 class="text-white font-orbitron text-[30px] font-medium">Understand and Improve Code</h2>
                    <p class="text-white font-inter font-thin text-[19px]">
                        AI-powered code analysis provides feedback that can help learners understand errors, improve their code, and develop programming skills.
                    </p>

                    <div class="h-auto lg:h-[15vh] flex items-center mt-4">
                        <ul class="flex flex-col gap-2 text-white">
                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Smart code analysis
                            </li>

                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Error and improvement feedback
                            </li>

                            <li class="flex items-center gap-3 text-white font-inter text-[19px]">
                                <span class="flex items-center justify-center w-7 h-7 rounded bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white text-s font-bold">
                                    ✓
                                </span>
                                Supports independent learning
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="w-full lg:w-[85vh] h-[40vh] lg:h-[60vh] bg-gradient-to-r from-[#C824EC] to-[#DF308D] p-[3px] rounded-lg">
                    <div class="w-full h-full bg-black rounded-2xl">
                        <video controls class="w-full h-full object-cover rounded-lg">
                            <source src="https://stream.mux.com/VZtzUzGRv02OhRnZCxcNg49OilvolTqdnFLEqBsTwaxU/high.mp4" type="video/mp4">
                        </video>
                    </div>
                </div>
            </div>
        </div>

        <!-- Fourth Feature -->
         <div class="feature h-screen w-full bg-[#05030a] flex items-center overflow-hidden">
            <div class="feature-inner flex flex-col-reverse lg:flex-row gap-10 lg:gap-15 w-full items-center justify-center">
                <div class="w-full lg:w-[85vh] h-[40vh] lg:h-[60vh] bg-gradient-to-r from-[#C824EC] to-[#DF308D] p-[3px] rounded-lg">
                    <div class="w-full h-full bg-black rounded-2xl">
                        <video controls class="w-full h-full object-cover rounded-lg">
                            <source src="https://stream.mux.com/VZtzUzGRv02OhRnZCxcNg49OilvolTqdnFLEqBsTwaxU/high.mp4" type="video/mp4">
                        </video>
                    </div>
                </div>

                <div class="flex flex-col gap-4 justify-center w-full lg:w-1/2">
                    <h2 class="text-white font-orbitron text-[30px] font-medium">VS Code Integration</h2>
                    <p class="text-white font-inter font-thin text-[19px]">
                        Bring accessible programming directly into Visual Studio Code through the Zero Vision Coding extension.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { SplitText } from "gsap/SplitText";

    gsap.registerPlugin(ScrollTrigger);
    gsap.registerPlugin(SplitText);

    document.addEventListener("DOMContentLoaded", () => {
        const titleSplit = new SplitText("#features-title", {
            type: "words,chars",
            charsClass: "char"
        });

        const descriptionSplit = new SplitText("#features-description", {
            type: "words"
        });

        const span = document.querySelector("#features-title span");
        if (span) {
            const chars = span.querySelectorAll(".char");
            chars.forEach(char => {
                char.classList.add(
                    "bg-gradient-to-r",
                    "from-[#C824EC]",
                    "to-[#DF308D]",
                    "bg-clip-text",
                    "text-transparent"
                );
            });
            span.classList.remove(
                "bg-gradient-to-r",
                "from-[#C824EC]",
                "to-[#DF308D]",
                "bg-clip-text",
                "text-transparent"
            );
        }

        const t1 = gsap.timeline({
            scrollTrigger: {
                trigger: "#features-title",
                start: "top 30%",
                end: "end 20%",
                toggleActions: "play none none reverse"
            }
        });

        t1.from(titleSplit.chars, {
            y: 150,
            opacity: 0,
            duration: 0.5,
            ease: "power4.out",
            stagger: 0.04
        })
        .from(descriptionSplit.words, {
            y: 20,
            opacity: 0,
            duration: 0.5,
            ease: "power3.out",
            stagger: 0.03
        }, "-=0.4");

        const features = gsap.utils.toArray<HTMLElement>(".feature");

        features.forEach((feature, index) => {
            ScrollTrigger.create({
                trigger: feature,
                start: "top top",
                pin: true,
                pinSpacing: index === features.length - 1,
                end: () => `+=${feature.offsetHeight}`
            });

            const inner = feature.querySelector(".feature-inner");
            if (inner) {
                gsap.from(inner, {
                    scrollTrigger: {
                        trigger: feature,
                        start: "top 80%",
                        toggleActions: "play none none reverse"
                    },
                    xPercent: index % 2 === 0 ? -50 : 20,
                    opacity: 0,
                    duration: 1,
                    ease: "power3.out"
                });
            }
        });
    })
</script>
