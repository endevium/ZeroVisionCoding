                        <label class="text-white font-thin text-[17px]">Message</label>
                        <textarea class="border border-darkgray h-52 w-126 rounded-lg text-white p-4 resize-none" />
                    </div>
                </div>

                <div>
                    <input type="submit" class="flex bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white font-inter font-bold text-[15px] h-14 w-126 my-5 items-center justify-center rounded-lg" />
