<div class="flex flex-row h-[120vh] pr-20 pl-20 justify-center items-center gap-6">
    <div class="flex flex-col gap-4 justify-center justify-center max-w-1/2">
        <h2 class="text-white font-orbitron text-[35px] font-bold">Get in touch</h2>
        <p class="text-white font-inter font-thin text-[19px]">
            Have questions, suggestions, or want to learn more about Zero Vision Coding? We’d love to hear from you. Reach out to our team for more information about our project and its mission to make programming more accessible and inclusive.
        </p>
    </div>

    <div class="flex justify-center items-center w-150 h-175 rounded-2xl p-5">
        <form class="flex flex-col gap-4" aria-required>
            <div class="flex flex-row gap-4">
                <div class="flex flex-col gap-4">
                    <label class="text-white font-thin text-[19px]">First Name</label>
                    <input class="border border-darkgray h-14 w-65 rounded-lg text-white p-4" type="text" />
                </div>

                <div class="flex flex-col gap-4">
                    <label class="text-white font-thin text-[19px]">Last Name</label>
                    <input class="border border-darkgray h-14 w-65 rounded-lg text-white p-4" type="text" />
                </div>
            </div>

            <div>
                <div class="flex flex-col gap-4">
                    <label class="text-white font-thin text-[19px]">Email Address</label>
                    <input class="border border-darkgray h-14 w-135 rounded-lg text-white p-4" type="email" />
                </div>
            </div>

            <div>
                <div class="flex flex-col gap-4">
                    <label class="text-white font-thin text-[19px]">Message</label>
                    <textarea class="border border-darkgray h-54 w-135 rounded-lg text-white p-4 resize-none" />
                </div>
            </div>

            <div>
                <input type="submit" class="flex bg-gradient-to-r from-[#C824EC] to-[#DF308D] text-white font-inter font-bold text-[16px] h-14 w-135 my-5 items-center justify-center rounded-lg" />
            </div>
        </form>
    </div>
</div>