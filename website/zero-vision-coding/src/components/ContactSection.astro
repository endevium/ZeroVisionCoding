<div class="flex flex-row h-[120vh] pr-20 pl-20 justify-center items-center gap-2" id="contact">
    <div class="flex flex-row bg-[#0a0a0f] p-13 justify-between rounded-3xl border border-darkgray">
        <div class="flex flex-col gap-4 justify-center max-w-1/2">
