---
import { Image } from "astro:assets";
---


<div class="flex flex-col h-[110vh] items-center pt-35 pr-20 pl-20 gap-5">
    <div class="flex flex-col gap-2 justify-center items-center ">
        <h2 class="text-white text-[35px] font-orbitron font-black">
            Releases
        </h2>

        <p class="text-white font-inter font-thin text-[17px] text-center">
            Everything you need to download, set up, and introduce <br />
            Zero Vision Coding to your learners.
        </p>
    </div>

    
    <div class="flex flex-row bg-[#0a0a0f] border-1 rounded-3xl border-darkgray w-full h-150">
        <!-- Tabs aaaa -->
        <div class="flex flex-col min-w-50 border-r border-r-darkgray h-full">
            <div class="flex flex-col h-45 w-full border-b border-b-darkgray text-white">
                <div class="flex flex-col min-h-12 p-4">
                    <p class="font-orbitron pl-2 text-[15px]">CHANNELS</p>
                </div>

                <div class="flex flex-col">
                    <button class="text-left hover:bg-lightblue transition-colors cursor-pointer pl-5 items-center h-8 font-inter text-[15px] font-thin">All</button>
                    <button class="text-left hover:bg-lightblue transition-colors cursor-pointer pl-5 items-center h-8 font-inter text-[15px] font-thin">Zero Vision Coding</button>
                    <button class="text-left hover:bg-lightblue transition-colors cursor-pointer pl-5 items-center h-8 font-inter text-[15px] font-thin">VS Code Extension</button>
                </div>
            </div>
            <div class="flex flex-col h-105 w-full text-white">
                <div class="flex flex-col min-h-12 p-4">
                    <p class="font-orbitron pl-2 text-[15px]">VERSIONS</p>
                </div>

                <div class="flex flex-col">
                    <button class="text-left hover:bg-lightblue transition-colors cursor-pointer pl-5 items-center h-8 font-inter text-[15px] font-thin">1.0.0</button>
                </div>
            </div>
        </div>

        <!--Versions aaaaaaa -->
        <div class="flex flex-col w-full h-full">
            <div class="flex flex-col h-15 w-full border-b border-b-darkgray text-white">
                <div class="flex flex-col min-h-12 p-4">
                    <p class="font-inter pl-2 text-[17px] tracking-wider">August 2026</p>
                </div>
            </div>

            <div class="flex flex-row p-5 w-full h-full gap-4">
                <div class="flex flex-col bg-black-idk w-75 h-55 rounded-lg">
                    <div class="flex flex-col h-33 border-b border-b-darkgray p-4">
                        <div class="flex flex-col">
                            <p class="font-inter  text-[15px] tracking-wider text-white">Zero Vision Coding: 1.0.0</p>
                        </div>

                        <div class="flex flex-col">
                            <p class="font-inter text-[14px] tracking-wider text-white font-thin">August 21, 2026</p>
                        </div>
                    </div>

                    <!-- Actual downloads lol -->
                    <div class="flex flex-row gap-4 h-full m-5 justify-center items-center">
                        <div class="flex flex-col w-50 h-25 border-2 border-darkgray rounded">
                            <div class="flex justify-center items-center bg-blacker w-full h-1/2 border-b border-b-darkgray">
                                <h2 class="flex text-white font-inter tracking-wider text-[15px]">Windows 11</h2>
                            </div>

                            <button class="flex flex-row gap-4 justify-center items-center hover:bg-lightergray transition-colors cursor-pointer w-full h-1/2 border-b border-b-darkgray">
                                <Image src="/download.png" alt="download icon" width="16" height="16" />
                                <h2 class="flex text-white font-inter tracking-wider text-[14px]">Download</h2>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="flex flex-col bg-black-idk w-75 h-55 rounded-lg">
                    <div class="flex flex-col h-33 border-b border-b-darkgray p-4">
                        <div class="flex flex-col">
                            <p class="font-inter  text-[15px] tracking-wider text-white">IDE Extension: 1.0.0</p>
                        </div>

                        <div class="flex flex-col">
                            <p class="font-inter text-[14px] tracking-wider text-white font-thin">August 21, 2026</p>
                        </div>
                    </div>

                    <!-- Actual downloads lol -->
                    <div class="flex flex-row gap-4 h-full m-5 justify-center items-center">
                        <div class="flex flex-col w-50 h-25 border-2 border-darkgray rounded">
                            <div class="flex justify-center items-center bg-blacker w-full h-1/2 border-b border-b-darkgray">
                                <h2 class="flex text-white font-inter tracking-wider text-[15px]">VS Code</h2>
                            </div>

                            <button class="flex flex-row gap-4 justify-center items-center hover:bg-lightergray transition-colors cursor-pointer w-full h-1/2 border-b border-b-darkgray">
                                <Image src="/download.png" alt="download icon" width="16" height="16" />
                                <h2 class="flex text-white font-inter tracking-wider text-[14px]">Download</h2>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>