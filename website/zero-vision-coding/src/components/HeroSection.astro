---
import { Image } from "astro:assets";
import MagicRings from "./MagicRings.jsx";
import Starfield from "./ui/starfield.tsx";
---


<div class="flex flex-col flex-1 pl-20 pr-20 h-[135vh] justify-center items-center mb-20 " id="home">
    <div id="title" class="flex flex-1 flex-col justify-center items-center gap-7 mt-30 z-10 -mb-20 pb-0">
        <h2 class="font-orbitron text-white font-black text-[75px] tracking-widest text-center leading-tight">
            Code Without <br />
            <span class="bg-gradient-to-r from-[#C824EC] to-[#DF308D] bg-clip-text text-transparent">Boundaries</span>
        </h2>

        <p id="description" class="text-white font-inter font-thin text-[21px] text-center">
            Zero Vision Coding is an AI-powered programming platform <br/> 
            designed to make coding accessible through voice, Braille, <br/>
            and intelligent assistance.
        </p>

        <div class="flex flex-row gap-7 mt-4">
            <button id="download-btn" class="flex bg-gradient-to-r from-[#C824EC] to-[#DF308D] transition-all duration-300 ease-in-out hover:scale-115 text-white font-inter font-bold text-[16px] h-14 w-45 items-center justify-center rounded-md cursor-pointer">Download</button>
            <div id="learn-more" class="rounded-lg bg-gradient-to-r from-[#C824EC] to-[#DF308D] p-[1px] transition-all duration-300 ease-in-out hover:scale-115">
                <button class="flex h-14 w-45 items-center justify-center rounded-md bg-black text-[16px] font-inter font-bold text-white cursor-pointer transition-all duration-300 ease-in-out hover:bg-gradient-to-r from-[#C824EC] to-[#DF308D] transition-colors">
                    Learn More
                </button>
            </div>
        </div>
    </div>

    <div class="relative flex flex-1 flex-col justify-center items-end gap-4">
