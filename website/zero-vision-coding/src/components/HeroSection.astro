                ringCount={2}
                speed={1}
                attenuation={15}
                lineThickness={4}
                baseRadius={0.35}
                radiusStep={0.1}
                scaleRate={0.1}
                opacity={1}
                blur={0}
                noiseAmount={0}
                rotation={0}
                ringGap={1.1}
